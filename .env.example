# Leave empty when using the Vite proxy, including through an ngrok frontend tunnel.
VITE_API_BASE_URL=
DB_PASSWORD=ChangeThis_StrongPassword123!
# Bắt buộc: chuỗi ngẫu nhiên >= 32 ký tự (vd. `openssl rand -base64 48`). Không dùng giá trị mẫu này.
JWT_SECRET=change-this-to-a-long-random-secret
# Đặt false khi deploy thật: API giả lập thanh toán cho phép khách tự đánh dấu đơn "đã thanh toán".
PAYMENT_SIMULATION_ENABLED=true
# Tắt Swagger UI trên production nếu không cần công khai tài liệu API.
SWAGGER_ENABLED=true
# Đăng nhập bằng Google: OAuth Client ID loại "Web application" (Google Cloud Console > APIs & Services > Credentials).
# Frontend và backend phải dùng cùng một Client ID. Để trống thì nút đăng nhập Google bị ẩn.
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
